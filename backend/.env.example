APP_NAME=PaperMatcher-AI
API_HOST=127.0.0.1
API_PORT=8002
DATASET_PATH=data/arXiv_scientific_dataset.csv

# Hybrid Retrieval Settings
RETRIEVAL_MODE=hybrid
TFIDF_WEIGHT=0.40
SEMANTIC_WEIGHT=0.60
SCORE_NORMALIZATION=minmax

# Sentence-BERT Settings
SBERT_MODEL_NAME=all-MiniLM-L6-v2
SBERT_MAX_SEQ_LENGTH=128
SBERT_EMBEDDINGS_PATH=models/sbert_embeddings.npy
